# Razorpay keys (Dashboard → Account & Settings → API Keys).
# Use rzp_test_... keys while testing, rzp_live_... in production.
# Set these in Vercel → Project → Settings → Environment Variables.
# For local `vercel dev`, copy this file to .env.local (git-ignored).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase (Project Settings → API). Customer profiles + 90-day order storage.
# Server-only: the service role key bypasses security rules. Never prefix it with REACT_APP_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser (public) values: same project URL + the anon/public key.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Shiprocket (Settings → API → Configure → Create an API User; use that user's
# email/password, not your main login). Pickup location = the exact nickname of
# your pickup address in Settings → Pickup Addresses. If unset, delivery uses
# deliveryCharge from src/data/gheeCatalog.json and orders are not pushed.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
